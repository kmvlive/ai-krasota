# ============================================================
# AI-krasota — пример переменных окружения
# Скопируйте в .env и заполните секреты. НИКОГДА не коммитьте .env
# ============================================================

# --- Общие ---
ENVIRONMENT=development          # development | staging | production
PROJECT_NAME=ai-krasota
BASE_DOMAIN=localhost            # ai-krasota.ru в проде; сайты салонов: <slug>.BASE_DOMAIN

# --- PostgreSQL ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=aikrasota
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=aikrasota
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis (cache + broker Celery) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Backend / безопасность ---
SECRET_KEY=change-me-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=60          # длинные сессии 30–90 дней (PRD §15.1)
FIRST_HOST=http://localhost:8000      # CORS
FRONTEND_ORIGIN=http://localhost:3000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BASE_DOMAIN=localhost

# --- AI (Timeweb, dashscope/qwen3.5-flash) — PRD §9 ---
TIMEWEB_AI_API_KEY=
TIMEWEB_AI_MODEL=dashscope/qwen3.5-flash
AI_COACH_FREE_QUESTIONS_PER_MONTH=20

# --- Telegram-боты (PRD §8) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Платежи (Т-Банк, PRD §12.4) ---
TBANK_PUBLIC_KEY=
TBANK_SECRET_KEY=

# --- Триал ---
TRIAL_DAYS=14
